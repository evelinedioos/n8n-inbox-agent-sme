        -64,
        256
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=From: {{ $json.from.text }}\nSubject: {{ $json.subject }}\nMessage ID: {{ $json.id }}\nThread ID: {{ $json.threadId }}\n\nBody:\n{{ $json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are the inbox assistant of a Belgian SME. For each email:\n1. Detect the language (French or Dutch) and ALWAYS write in that language.\n2. Classify the email in exactly one category: APPOINTMENT, QUOTE_REQUEST, COMPLAINT or OTHER.\n3. APPOINTMENT: check Google Calendar (tool get_calendar_events) for free 30-minute slots in the next 5 working days between 09:00 and 17:00 (Europe/Brussels). Create a polite reply DRAFT (tool create_reply_draft) proposing exactly 3 slots.\n4. QUOTE_REQUEST: extract company, contact name, email, what they need, quantity/budget and deadline (use \"unknown\" if missing). Append this to the \"Leads\" sheet (tool append_lead), add the label \"sales\" (tool add_label_sales), and create a short reply DRAFT (tool create_reply_draft) confirming we received the request and will come back within 2 working days.\n5. COMPLAINT: do NOT reply to the customer. Add the label \"dringend\" (tool add_label_dringend) so a human handles it personally.\n6. OTHER: do nothing except logging.\nNever send emails. Never invent prices, promises or dates that are not in the calendar. If you are unsure, choose the safest option and set confidence to low.\nAt the end, return JSON: language, category, action_taken, reasoning, confidence."
        }
      },
      "id": "a96c4cd2-c6b5-4563-8e15-a650ee4f50a5",
      "name": "Inbox Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1008,
        304
